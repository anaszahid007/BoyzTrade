{
  "name": "backend",
  "version": "1.0.0",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed:admin": "node --input-type=module -e \"import('./src/seed.js').then(({ seedAdmin }) => seedAdmin())\"",
    "seed:qb": "node --input-type=module -e \"import('./src/seed.js').then(({ seedQuestsAndBadges }) => seedQuestsAndBadges())\"",
    "seed": "npm run seed:admin && npm run seed:qb"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "paper trading app backend",
  "dependencies": {
    "argon2": "^0.44.0",
    "axios": "^1.16.1",
    "cloudinary": "^2.10.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.6.2",
    "morgan": "^1.10.1",
    "multer": "^2.2.0",
    "nodemailer": "^8.0.7",
    "nodemon": "^3.1.14",
    "socket.io": "^4.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "vitest": "^4.1.9"
  }
}
